# Added automatically when a Neon database is connected in Vercel → Storage.
# For local development, copy it from Vercel → Storage → your database → .env.local tab.
DATABASE_URL=

# Optional. If unset, the first visit to /admin asks you to create the admin password.
ADMIN_PASSWORD=
# Optional: force auto-approve for every event (each event also has its own toggle in /admin)
AUTO_APPROVE=false
